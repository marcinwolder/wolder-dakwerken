---
// The site has one page tree per language (`/pl/`, `/en/`, ...). The root only sends the visitor to the right one.
import { FALLBACK_LANGUAGE, LANGUAGES, localizedPath, STORAGE_KEY } from "../i18n";

const codes = LANGUAGES.map((l) => l.code);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Wolder Dakwerken</title>
        <script
            is:inline
            define:vars={{
                codes,
                fallback: FALLBACK_LANGUAGE,
                storageKey: STORAGE_KEY,
                targets: Object.fromEntries(
                    codes.map((code) => [code, localizedPath(code, "/")]),
                ),
            }}>
            // The language chosen before wins, then the browser languages in order of preference.
            var lang = null;
            try {
                var stored = localStorage.getItem(storageKey);
                if (codes.indexOf(stored) !== -1) lang = stored;
            } catch (e) {}
            var tags = navigator.languages || [navigator.language];
            for (var i = 0; !lang && i < tags.length; i++) {
                var base = String(tags[i]).toLowerCase().split("-")[0];
                if (codes.indexOf(base) !== -1) lang = base;
            }
            location.replace(targets[lang || fallback] + location.search + location.hash);
        </script>
    </head>
    <body>
        <noscript>
            {
                LANGUAGES.map((l) => (
                    <p>
                        <a href={localizedPath(l.code, "/")}>{l.name}</a>
                    </p>
                ))
            }
        </noscript>
    </body>
</html>
