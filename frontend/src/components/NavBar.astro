---
import LanguagePicker from "./LanguagePicker.tsx";
import HamburgerMenu from "./HamburgerMenu.astro";
import logo from "../assets/logo_shrink.png";
import { withBase } from "../utils/withBase";
import { localizedPath, type Language } from "../i18n";

const { lang } = Astro.props as { lang: Language };
// The link points at the page language; the script below follows an in-page language switch.
const homePath = localizedPath(lang, "/");
const isHome = Astro.url.pathname.replace(/\/$/, "") === withBase(`/${lang}`);
---

<div class="grid grid-cols-3 items-center">
    <div class="justify-self-start">
        <LanguagePicker client:load lang={lang} />
    </div>
    <div class="flex justify-center">
        <a href={homePath} data-home-base={withBase("/")}>
            <img
                src={logo.src}
                alt="logo"
                class:list={[
                    "w-16 brightness-0 drop-shadow-sm drop-shadow-gray-300",
                    { hidden: isHome },
                ]}
            />
        </a>
    </div>
    <!-- <div class="justify-self-end">
        <HamburgerMenu />
    </div> -->
</div>

<script>
    // An in-page language switch only changes the URL and <html lang>, so resolve the link on click.
    const home = document.querySelector<HTMLAnchorElement>("a[data-home-base]");
    home?.addEventListener("click", () => {
        home.href = `${home.dataset.homeBase}${document.documentElement.lang}/`;
    });
</script>
